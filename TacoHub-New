-- FUNCIONES DE ACTUALIZACIÓN DE INTERFAZ
local function buildEggString()
    local lines = { string.format("★ Total Mascotas: %s", formatNumber(totalPetsCount)) }
    if tick() - lastSuccessfulHatchTime > 30 then
        table.insert(lines, "⚠️ Sin compras recientes")
    else
        table.insert(lines, "🟢 Estado: Funcionando fluidamente")
    end

    local itemsList = {}
    for name, count in pairs(petsInventoryTrack) do
        local nameLower = name:lower()
        if nameLower:find("olympic") or nameLower:find("secret") then
            table.insert(itemsList, string.format("• <font color=\"#FF66FF\"><b>%s</b></font>: <font color=\"#FFDC00\">x%s</font>", name, formatNumber(count)))
        else
            table.insert(itemsList, string.format("• %s: x%s", name, formatNumber(count)))
        end
    end

    table.sort(itemsList)
    for _, str in ipairs(itemsList) do table.insert(lines, str) end
    return table.concat(lines, "\n")
end

local function buildMerchantString()
    local textList = {}
    for itemName, count in pairs(purchasedMerchantItems) do
        table.insert(textList, string.format("• %s: x%s", itemName, formatNumber(count)))
    end

    if #textList > 0 then
        table.sort(textList)
        return table.concat(textList, "\n")
    else
        return "Ningún ítem comprado aún."
    end
end

local function buildVoidString()
    return string.format("• Reclamadas: %s\n• Enviadas al Void: %s", formatNumber(voidClaimedCount), formatNumber(voidSentCount))
end

local function updateOverlayUI()
    if not isScriptRunning then return end
    
    local activeTasks = {}
    if getgenv().AutoHatchActive == true then table.insert(activeTasks, "auto huevos") end
    if getgenv().AutoBuyActive == true then table.insert(activeTasks, "auto tiendas") end
    if getgenv().AutoVoidActive == true then table.insert(activeTasks, "auto void") end

    local statusHeader = ""
    if #activeTasks > 0 then
        local tasksFormatted = table.concat(activeTasks, ", ")
        TitleLbl.Text = "🌮 TacoHub [🟢 ACTIVO]"
        TitleLbl.TextColor3 = THEME.StatusActive
        statusHeader = "🟢 ACTIVO | " .. tasksFormatted
        StatusDot.BackgroundColor3 = THEME.StatusActive
    else
        TitleLbl.Text = "🌮 TacoHub [⚪ INACTIVO]"
        TitleLbl.TextColor3 = THEME.Text
        statusHeader = "⚪ INACTIVO"
        StatusDot.BackgroundColor3 = THEME.StatusInactive
    end

    local afkLine = "🛡️ Anti-AFK: <font color=\"#46DC5A\"><b>Activo</b></font>"
    LblStatus.Text = statusHeader .. "\n" .. afkLine
    CardStatus.Size = UDim2.new(1, -4, 0, 75)

    local selectedEggDisplay = (selectedEggValue ~= "") and (" <font color=\"#FFDC00\">[" .. selectedEggValue .. "]</font>") or " <font color=\"#AAAAAA\">[Ninguno]</font>"
    TitleEggs.Text = "HUEVOS" .. selectedEggDisplay

    local eggText = buildEggString()
    LblEggs.Text = eggText
    CardEggs.Size = UDim2.new(1, -4, 0, math.max(75, #eggText:split("\n") * 22 + 35))

    local selectedShopDisplay = (selectedMerchantValue ~= "") and (" <font color=\"#FFDC00\">[" .. selectedMerchantValue .. "]</font>") or " <font color=\"#AAAAAA\">[Ninguna]</font>"
    TitleShop.Text = "TIENDA" .. selectedShopDisplay

    local restockStr = ""
    if merchantTimerEndTime then
        local remaining = merchantTimerEndTime - tick()
        if remaining > 0 then
            restockStr = "⏱️ Próximo Restock en: " .. formatTime(remaining)
        else
            restockStr = "⏱️ ¡Tiempo cumplido! Esperando actualización..."
        end
    else
        restockStr = "⏱️ Temporizador iniciará con la última compra."
    end

    local shopItemsStr = buildMerchantString()
    local combinedShopText = restockStr .. "\n\n" .. shopItemsStr
    LblShop.Text = combinedShopText
    CardShop.Size = UDim2.new(1, -4, 0, math.max(85, #combinedShopText:split("\n") * 22 + 35))

    local voidText = buildVoidString()
    LblVoidFloat.Text = voidText
    CardVoidFloat.Size = UDim2.new(1, -4, 0, math.max(75, #voidText:split("\n") * 22 + 35))

    if updateMerchantSummaryUI then updateMerchantSummaryUI() end
    if updateVoidUI then updateVoidUI() end

    ScrollFloat.CanvasSize = UDim2.new(0, 0, 0, FloatList.AbsoluteContentSize.Y + 12)
end

local function getSelectedMerchantItemsCount()
    local count = 0
    for _, isSelected in pairs(selectedMerchantItems) do
        if isSelected then count = count + 1 end
    end
    return count
end

