local CardVoidStatus, LblVoidStatus

local AutoVoidToggle = createToggle(TabVoid, "Activar Auto Void & Claim", false, function(value)
    voidSessionToken = voidSessionToken + 1
    local currentToken = voidSessionToken
    getgenv().AutoVoidActive = value

    updateOverlayUI()

    if value then
        LblVoidStatus.Text = "Enviando mascotas Golden y Reclamando..."
        task.spawn(function()
            while getgenv().AutoVoidActive and isScriptRunning and currentToken == voidSessionToken do
                pcall(function()
                    local voidData = PetVoidService.RF.init:InvokeServer()
                    if type(voidData) == "table" then
                        for key, item in pairs(voidData) do
                            if not getgenv().AutoVoidActive or currentToken ~= voidSessionToken then break end
                            local guid = (type(item) == "table" and item.Guid) or key
                            if guid and type(guid) == "string" and #guid == 36 then
                                onClaim:FireServer(guid)
                                voidClaimedCount = voidClaimedCount + 1
                                updateVoidUI()
                                task.wait(0.1)
                            end
                        end
                    end
                end)

                pcall(function()
                    local petData = PetService.RF.getOwned:InvokeServer()
                    if type(petData) == "table" then
                        for uuid, data in pairs(petData) do
                            if not getgenv().AutoVoidActive or currentToken ~= voidSessionToken then break end
                            if type(uuid) == "string" and #uuid == 36 and type(data) == "table" then
                                local tier = tostring(data.Tier or ""):lower()
                                local isLocked = data.Locked == true
                                if (tier:find("gold") or tier:find("golden")) and not isLocked then
                                    onCraftToVoid:FireServer(uuid)
                                    voidSentCount = voidSentCount + 1
                                    updateVoidUI()
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
            if currentToken == voidSessionToken then LblVoidStatus.Text = "Auto Void desactivado." end
        end)
    else
        LblVoidStatus.Text = "Auto Void desactivado."
    end
    return true
end)

