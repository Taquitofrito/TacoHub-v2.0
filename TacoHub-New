local isDraggingMin = false
local dragStartMin = nil
local startPosMin = nil
local clickStartTime = 0

table.insert(connectionsToClean, MinimizedFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingMin = true
        clickStartTime = tick()
        dragStartMin = input.Position
        startPosMin = MinimizedFrame.Position
    end
end))

table.insert(connectionsToClean, UserInputService.InputChanged:Connect(function(input)
    if isDraggingMin and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartMin
        MinimizedFrame.Position = UDim2.new(startPosMin.X.Scale, startPosMin.X.Offset + delta.X, startPosMin.Y.Scale, startPosMin.Y.Offset + delta.Y)
    end
end))

table.insert(connectionsToClean, UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isDraggingMin then
            isDraggingMin = false
            if tick() - clickStartTime < 0.25 and (input.Position - dragStartMin).Magnitude < 8 then
                setFloatMinimizedState(false)
            end
        end
    end
end))

