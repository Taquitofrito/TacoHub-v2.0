local function getEggNames()
    local eggNamesSet = {}
    local function registerEgg(rawName)
        if not rawName then return end
        local cleanName = tostring(rawName):gsub("%s*[Ee][Gg][Gg]%s*$", ""):match("^%s*(.-)%s*$")
        if not cleanName or cleanName == "" or cleanName:lower():find("rewind") or tonumber(cleanName) then return end
        if cleanName == "IceSpiked" then cleanName = "IceSpikes" end
        eggNamesSet[cleanName] = true
    end

    pcall(function()
        local dataFolder = ReplicatedStorage:FindFirstChild("Data")
        if dataFolder then
            local eggsModule = dataFolder:FindFirstChild("Eggs") or dataFolder:FindFirstChild("EggData")
            if eggsModule then
                local dataTable = require(eggsModule)
                if typeof(dataTable) == "table" then
                    for eggName, _ in pairs(dataTable) do registerEgg(eggName) end
                end
            end
        end
    end)

    pcall(function()
        local workspaceEggs = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("EggModels")
        if workspaceEggs then
            for _, eggModel in ipairs(workspaceEggs:GetChildren()) do registerEgg(eggModel.Name) end
        end
    end)

    local manualEventEggs = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cave", "Lavacrystal", "IceSpikes", "Admin"}
    for _, manualEgg in ipairs(manualEventEggs) do registerEgg(manualEgg) end

    local cleanEggList = {}
    for eggName in pairs(eggNamesSet) do table.insert(cleanEggList, eggName) end
    table.sort(cleanEggList)
    return cleanEggList
end

local function getAllMerchantItems()
    local LimitedMerchant = require(ReplicatedStorage.Data.LimitedMerchant)
    local merchantList = {}
    local merchantItemsMap = {}
    local itemDataMap = {}

    for merchantName, merchantData in pairs(LimitedMerchant) do
        if typeof(merchantData) == "table" and merchantData.Items then
            table.insert(merchantList, merchantName)
            merchantItemsMap[merchantName] = {}

            for slotIndex, itemList in pairs(merchantData.Items) do
                for itemIndex, item in ipairs(itemList) do
                    local title = item.Title or "Desconocido"
                    local price = item.Price or 0
                    local currency = typeof(item.Currency) == "string" and item.Currency or (typeof(item.Currency) == "table" and item.Currency.Item or "Moneda")
                    local cleanName = string.format("Slot %s: %s (%.0f %s)", slotIndex, title, price, currency)
                    
                    table.insert(merchantItemsMap[merchantName], cleanName)
                    itemDataMap[merchantName .. ":" .. cleanName] = {
                        merchant = merchantName, slot = tonumber(slotIndex), index = itemIndex, title = title, raw = item
                    }
                end
            end
            table.sort(merchantItemsMap[merchantName])
        end
    end
    table.sort(merchantList)

    return merchantList, merchantItemsMap, itemDataMap
end

local function getLiveStockData()
    local liveData = {}
    pcall(function()
        local CustomReplicaController = Knit.GetController("CustomReplicaController")
        local replica = CustomReplicaController and CustomReplicaController:GetReplica()
        if replica and replica.Data and replica.Data.LimitedMerchant then
            local LimitedMerchant = require(ReplicatedStorage.Data.LimitedMerchant)
            for merchantName, merchantData in pairs(replica.Data.LimitedMerchant) do
                if merchantData and merchantData.Items then
                    for slotIndex, itemData in pairs(merchantData.Items) do
                        local currentItem = LimitedMerchant[merchantName] and 
                                          LimitedMerchant[merchantName].Items and 
                                          LimitedMerchant[merchantName].Items[slotIndex] and 
                                          LimitedMerchant[merchantName].Items[slotIndex][itemData.Index]
                        
                        liveData[merchantName .. ":" .. tostring(slotIndex)] = {
                            stock = itemData.Stock,
                            index = itemData.Index,
                            title = currentItem and currentItem.Title or "Desconocido",
                            fullItem = currentItem
                        }
                    end
                end
            end
        end
    end)
    return liveData
end

local function formatTime(seconds)
    if not seconds or seconds <= 0 then return "00:00" end
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

local function applyDragLogic(dragHandle, targetFrame)
    local dragging, dragStart, startPos = false, nil, nil
    dragHandle.Active = true
    targetFrame.Active = true

    table.insert(connectionsToClean, dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
        end
    end))

    table.insert(connectionsToClean, UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))

    table.insert(connectionsToClean, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

