local function createTab(name, icon)
    local tabContainer = Instance.new("ScrollingFrame")
    tabContainer.Size = UDim2.new(1, -16, 1, -16)
    tabContainer.Position = UDim2.new(0, 8, 0, 8)
    tabContainer.BackgroundTransparency = 1
    tabContainer.BorderSizePixel = 0
    tabContainer.ScrollBarThickness = 6
    tabContainer.ScrollBarImageColor3 = THEME.AccentLight
    tabContainer.Visible = false
    tabContainer.ZIndex = 2
    tabContainer.Parent = ContentArea

    local tabList = Instance.new("UIListLayout")
    tabList.Padding = UDim.new(0, 12)
    tabList.SortOrder = Enum.SortOrder.LayoutOrder
    tabList.Parent = tabContainer

    table.insert(connectionsToClean, tabList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabContainer.CanvasSize = UDim2.new(0, 0, 0, tabList.AbsoluteContentSize.Y + 15)
    end))

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 48)
    btn.BackgroundColor3 = THEME.Background
    btn.BackgroundTransparency = 0.45
    btn.Text = " " .. icon .. "  " .. name:upper()
    btn.TextColor3 = THEME.SubText
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 17
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 3
    btn.Parent = Sidebar

    applyTextStroke(btn)

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 12)
    btnCorner.Parent = btn

    createNeonStroke(btn, THEME.Accent, 1)

    btn.MouseButton1Click:Connect(function()
        closeActiveModalPicker()
        ModalScreen.Enabled = false
        for _, tFrame in pairs(TabFrames) do tFrame.Visible = false end
        for _, tBtn in pairs(TabButtons) do 
            tBtn.BackgroundColor3 = THEME.Background 
            tBtn.BackgroundTransparency = 0.45
            tBtn.TextColor3 = THEME.SubText
        end
        tabContainer.Visible = true
        btn.BackgroundColor3 = THEME.CardBg
        btn.BackgroundTransparency = 0.25
        btn.TextColor3 = THEME.AccentLight
    end)

    TabFrames[name] = tabContainer
    TabButtons[name] = btn

    return tabContainer
end

