createSectionHeader(TabHuevos, "Configura la apertura de huevos")

local purchaseRemote = ReplicatedStorage.Packages.Knit.Services.EggService.RF.purchaseEgg

local function handleHatchLogic(value)
    if value then
        if not selectedEggValue or selectedEggValue == "" then
            showAlert("⚠️ Huevo no seleccionado", "Por favor selecciona un huevo antes de activar el Auto Hatch.")
            return false
        end
    end

    hatchSessionToken = hatchSessionToken + 1
    local currentToken = hatchSessionToken
    getgenv().AutoHatchActive = value

    updateOverlayUI()

    if value then
        lastSuccessfulHatchTime = tick()
        task.spawn(function()
            while getgenv().AutoHatchActive and isScriptRunning and currentToken == hatchSessionToken do
                local selectedEgg = selectedEggValue
                if selectedEgg and selectedEgg ~= "" then
                    local args = {selectedEgg, nil, nil, false, nil, true}
                    local success, result = pcall(function()
                        return purchaseRemote:InvokeServer(unpack(args))
                    end)

                    if currentToken == hatchSessionToken and isScriptRunning then
                        if success and typeof(result) == "table" and #result > 0 then
                            local petsAddedThisCycle = 0
                            for _, petData in pairs(result) do
                                local name = (typeof(petData) == "table" and (petData.Name or petData.Pet)) or tostring(petData)
                                if name and name ~= "" then
                                    petsInventoryTrack[name] = (petsInventoryTrack[name] or 0) + 1
                                    totalPetsCount = totalPetsCount + 1
                                    petsAddedThisCycle = petsAddedThisCycle + 1
                                end
                            end

                            if petsAddedThisCycle > 0 then 
                                lastSuccessfulHatchTime = tick()
                                updateEggUI()
                            end
                        end
                    end
                else
                    task.wait(0.2)
                end
                task.wait()
            end
        end)
    end
    return true
end

