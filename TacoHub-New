    container.ClipsDescendants = true
    container.ZIndex = 2
    container.Parent = parent

    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(0, 12)
    cCorner.Parent = container

    createNeonStroke(container, THEME.Border, 1)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -85, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.Text = text
    lbl.TextColor3 = THEME.Text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 18
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.ZIndex = 3
    lbl.Parent = container

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.fromOffset(58, 30)
    toggleBtn.Position = UDim2.new(1, -70, 0.5, -15)
    toggleBtn.Text = ""
    toggleBtn.BackgroundColor3 = default and THEME.Accent or THEME.Sidebar
    toggleBtn.BackgroundTransparency = 0.3
    toggleBtn.ClipsDescendants = true
    toggleBtn.ZIndex = 3
    toggleBtn.Parent = container

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(1, 0)
    tCorner.Parent = toggleBtn

    createNeonStroke(toggleBtn, THEME.AccentLight, 1)

    -- CÍRCULO INTERNO
    local circle = Instance.new("Frame")
    circle.Size = UDim2.fromOffset(22, 22)
    circle.Position = default and UDim2.new(1, -26, 0.5, -11) or UDim2.new(0, 4, 0.5, -11)
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.BorderSizePixel = 0
    circle.ZIndex = 4
    circle.Parent = toggleBtn

    local cirCorner = Instance.new("UICorner")
    cirCorner.CornerRadius = UDim.new(1, 0)
    cirCorner.Parent = circle

    local state = default

    local function setVisualState(newState)
        state = newState
        TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = state and THEME.Accent or THEME.Sidebar}):Play()
        TweenService:Create(circle, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -26, 0.5, -11) or UDim2.new(0, 4, 0.5, -11)}):Play()
    end

    toggleBtn.MouseButton1Click:Connect(function()
        local targetState = not state
        local allowed = callback(targetState)
        if allowed ~= false then setVisualState(targetState) end
    end)

    return container, setVisualState, function(newState)
        local allowed = callback(newState)
        if allowed ~= false then setVisualState(newState) end
    end
end

