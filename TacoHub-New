        BtnConfirm.MouseButton1Click:Connect(closeActiveModalPicker)
        PickerModalScreen.Enabled = true
    end

    ActionBtn.MouseButton1Click:Connect(openPicker)

    return { 
        GetValue = function() return selectedValue end,
        SetValue = function(val)
            selectedValue = val or ""
            updateText()
            callback(selectedValue)
        end
    }
end

