local populateGridItems = function(merchantName)
    for _, child in ipairs(ModalScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    if not merchantName or merchantName == "" then return end

    local items = merchantItemsMap[merchantName] or {}
    for _, itemName in ipairs(items) do
        local btn = Instance.new("TextButton")
        btn.Name = itemName
        btn.Text = itemName
        btn.Size = UDim2.new(0, 175, 0, 75)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 16
        btn.TextWrapped = true
        btn.Parent = ModalScroll

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = btn

        local function applyStyle()
            if selectedMerchantItems[itemName] then
                btn.BackgroundColor3 = THEME.SoftPurple
                btn.TextColor3 = THEME.TextDark
                btn.BackgroundTransparency = 0.1
            else
                btn.BackgroundColor3 = THEME.CardBg
                btn.TextColor3 = THEME.Text
                btn.BackgroundTransparency = 0.4
            end
        end
        applyStyle()

        btn.MouseButton1Click:Connect(function()
            selectedMerchantItems[itemName] = not selectedMerchantItems[itemName]
            applyStyle()
            updateSelectItemsBtnText()
        end)
    end

    ModalScroll.CanvasSize = UDim2.new(0, 0, 0, ModalGrid.AbsoluteContentSize.Y + 12)
end

local CardStatusBuy, LblStatusBuy

startAutoBuyLogic = function(enabled)
    if enabled then
        if not selectedMerchantValue or selectedMerchantValue == "" then
            showAlert("⚠️ Tienda no seleccionada", "Por favor selecciona una tienda antes de activar la Auto Compra.")
            return false
        end

        if getSelectedMerchantItemsCount() == 0 then
            showAlert("⚠️ Sin ítems seleccionados", "Debes seleccionar al menos 1 ítem del menú de la tienda antes de activar la Auto Compra.")
            return false
        end
    end

    buySessionToken = buySessionToken + 1
    local currentToken = buySessionToken
    getgenv().AutoBuyActive = enabled

    updateOverlayUI()

    if enabled then
        LblStatusBuy.Text = "Iniciando bucle de auto-compra..."
        
        task.spawn(function()
            while getgenv().AutoBuyActive and isScriptRunning and currentToken == buySessionToken do
                local liveData = getLiveStockData()
                local purchasesMade = false
                
                for itemName, isSelected in pairs(selectedMerchantItems) do
                    if isSelected then
                        local infoKey = (selectedMerchantValue or "") .. ":" .. itemName
                        local info = itemDataMap[infoKey]
                        
                        if info then
                            local merchantName = info.merchant
                            local slot = info.slot
                            local merchantSlotKey = merchantName .. ":" .. tostring(slot)
                            local liveInfo = liveData[merchantSlotKey]
                            
                            if liveInfo and liveInfo.stock and liveInfo.stock > 0 then
                                local itemTitle = info.raw.Title
                                if itemTitle == liveInfo.title then
                                    LblStatusBuy.Text = "Intentando comprar: [" .. merchantName .. "] " .. itemTitle
                                    
                                    local success, result = pcall(function()
                                        return merchantRemote:InvokeServer(merchantName, slot)
                                    end)
                                    
                                    if success then
                                        LblStatusBuy.Text = "🟢 Comprado con éxito: [" .. merchantName .. "] " .. itemTitle
                                        purchasedMerchantItems[itemTitle] = (purchasedMerchantItems[itemTitle] or 0) + 1
                                        totalMerchantPurchasesCount = totalMerchantPurchasesCount + 1
                                        purchasesMade = true

                                        merchantTimerEndTime = tick() + 1190
                                        updateOverlayUI()
                                    else
                                        LblStatusBuy.Text = "🔴 Error al comprar: " .. tostring(result)
                                    end
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
                
                if not purchasesMade and currentToken == buySessionToken then
                    LblStatusBuy.Text = "Buscando ítems en tienda...\nÚltima revisión: " .. os.date("%X")
                end
                
                task.wait(1.5)
            end
            if currentToken == buySessionToken then LblStatusBuy.Text = "Auto compra desactivada." end
        end)
    else
        LblStatusBuy.Text = "Auto compra desactivada."
    end
    return true
end

