local function createToggle(parent, text, default, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -4, 0, 56)
    container.Position = UDim2.new(0, 2, 0, 0)
    container.BackgroundColor3 = THEME.CardBg
